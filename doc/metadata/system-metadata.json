{
  "system": {
    "name": "ATLAS",
    "full_name": "Adaptive Thinking and Learning Architecture System",
    "version": "1.0.0",
    "description": "Dynamic knowledge management framework with pattern language integration",
    "license": "MIT",
    "repository": "https://github.com/atlas-team/atlas",
    "homepage": "https://atlas-knowledge.org",
    "documentation": "https://atlas-knowledge.readthedocs.io/",
    "created": "2023-01-01",
    "last_updated": "2024-12-01"
  },
  "architecture": {
    "core_components": [
      {
        "name": "ATLASEngine",
        "module": "atlas.core.engine",
        "description": "Main orchestration system for ATLAS framework",
        "responsibilities": [
          "Entity management",
          "Pattern coordination", 
          "Query execution",
          "System metrics",
          "Graph management"
        ],
        "interfaces": ["Python API"],
        "dependencies": ["networkx", "collections"]
      },
      {
        "name": "Entity",
        "module": "atlas.entities.entity", 
        "description": "Fundamental objects with attributes and pattern assignments",
        "responsibilities": [
          "Attribute management",
          "Pattern assignment",
          "Anomaly tracking",
          "Metadata handling",
          "Serialization"
        ],
        "interfaces": ["Python class", "Dict serialization", "JSON export"],
        "dependencies": ["uuid", "dataclasses"]
      },
      {
        "name": "Pattern", 
        "module": "atlas.patterns.pattern",
        "description": "Abstract templates defining entity structure and expectations",
        "responsibilities": [
          "QKit management",
          "Inheritance hierarchy",
          "Effectiveness scoring",
          "Similarity calculation",
          "Pattern validation"
        ],
        "interfaces": ["Python class", "Dict serialization"],
        "dependencies": ["atlas.entities.entity"]
      },
      {
        "name": "iQuery",
        "module": "atlas.queries.iquery",
        "description": "Itemized queries for structured information requests",
        "responsibilities": [
          "Query execution",
          "Priority management", 
          "Status tracking",
          "Context handling",
          "Result processing"
        ],
        "interfaces": ["Python class", "Dict serialization"],
        "dependencies": ["enum", "typing"]
      },
      {
        "name": "Attribute",
        "module": "atlas.entities.attribute",
        "description": "Specialized entities representing shared properties",
        "responsibilities": [
          "Reference ID management",
          "Cross-system linking",
          "Validation rules",
          "Metadata tracking"
        ],
        "interfaces": ["Python class", "Dict serialization"],
        "dependencies": ["atlas.entities.entity"]
      },
      {
        "name": "PromptInterface",
        "module": "atlas.interfaces.prompt_interface",
        "description": "Translation layers for system interoperability",
        "responsibilities": [
          "Data transformation",
          "Input validation",
          "Output validation",
          "Protocol translation"
        ],
        "interfaces": ["Abstract base class", "HTTP endpoints"],
        "dependencies": ["abc", "typing"]
      }
    ],
    "design_patterns": [
      "Strategy Pattern (PromptInterface)",
      "Factory Pattern (Entity creation)",
      "Observer Pattern (System metrics)", 
      "Composite Pattern (Pattern hierarchy)",
      "Command Pattern (iQuery execution)"
    ],
    "data_flow": [
      "Input → PromptInterface → Entity/Pattern/Query",
      "Entity → Pattern assignment → QKit inheritance",
      "iQuery → Pattern targeting → Entity search",
      "Results → PromptInterface → Output format"
    ]
  },
  "capabilities": {
    "core_features": [
      {
        "name": "Dynamic Pattern Management",
        "description": "Flexible pattern assignment and inheritance system",
        "maturity": "stable",
        "performance": "high",
        "scalability": "horizontal"
      },
      {
        "name": "Question-Oriented Discovery",
        "description": "iQuery system for structured information requests",
        "maturity": "stable", 
        "performance": "medium",
        "scalability": "vertical"
      },
      {
        "name": "Modular Entity Architecture",
        "description": "Composable entities with flexible attributes",
        "maturity": "stable",
        "performance": "high",
        "scalability": "horizontal"
      },
      {
        "name": "Cross-Domain Interoperability",
        "description": "Data exchange without shared standards",
        "maturity": "beta",
        "performance": "medium",
        "scalability": "vertical"
      },
      {
        "name": "Cognitive Security Framework",
        "description": "Information quality and provenance management",
        "maturity": "alpha",
        "performance": "low",
        "scalability": "limited"
      }
    ],
    "visualization": [
      {
        "name": "Network Topology",
        "module": "atlas.visualization.graph_viz",
        "formats": ["PNG", "SVG", "PDF", "HTML"],
        "interactive": true,
        "dependencies": ["matplotlib", "networkx"]
      },
      {
        "name": "Pattern Hierarchy",
        "module": "atlas.visualization.pattern_viz", 
        "formats": ["PNG", "SVG", "PDF"],
        "interactive": false,
        "dependencies": ["matplotlib", "networkx"]
      },
      {
        "name": "System Metrics",
        "module": "atlas.visualization.metrics_viz",
        "formats": ["PNG", "SVG", "PDF", "HTML"],
        "interactive": true,
        "dependencies": ["matplotlib", "plotly"]
      },
      {
        "name": "Network Analysis", 
        "module": "atlas.visualization.network_viz",
        "formats": ["PNG", "SVG", "PDF", "HTML"],
        "interactive": true,
        "dependencies": ["matplotlib", "networkx", "plotly"]
      },
      {
        "name": "Animation",
        "module": "atlas.visualization.animation_viz",
        "formats": ["GIF", "MP4", "HTML"],
        "interactive": true,
        "dependencies": ["matplotlib", "pillow"]
      }
    ],
    "export_formats": [
      {
        "format": "JSON",
        "description": "Native ATLAS format with full fidelity",
        "use_cases": ["Data exchange", "Backup", "API responses"],
        "compression": "optional",
        "streaming": true
      },
      {
        "format": "GraphML",
        "description": "Standard graph format for network analysis",
        "use_cases": ["External analysis", "Visualization", "Research"],
        "compression": "gzip",
        "streaming": false
      },
      {
        "format": "YAML",
        "description": "Human-readable configuration format",
        "use_cases": ["Configuration", "Documentation", "Templates"],
        "compression": "optional",
        "streaming": false
      },
      {
        "format": "CSV",
        "description": "Tabular data format for spreadsheet analysis",
        "use_cases": ["Data analysis", "Reporting", "Integration"],
        "compression": "optional",
        "streaming": true
      }
    ]
  },
